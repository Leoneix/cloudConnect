# Application Configuration
APP_NAME=MyCloud
APP_ENV=development

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# SQLite Database Location
DATABASE_URL=sqlite:///./data/mycloud.db

# Storage Path (dedicated external HDD root or local dev folder) ./data/storage 
STORAGE_PATH=D:/cloud

# Session & Security Settings
SESSION_EXPIRE_MINUTES=10080
MAX_UPLOAD_SIZE_MB=5120
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Cookie Settings (set COOKIE_SECURE=true when running over HTTPS behind a reverse proxy/Tailscale)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=mycloud_session
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://100.99.177.87:5173

# Initial Admin Account (created during `python -m app.db.init_db` if not exists)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=admin
